# ─── Groq LLM API ───────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# ─── PostgreSQL Database ─────────────────────────────────────────────────────
# Local dev:    postgresql+psycopg://postgres:password@localhost:5432/news_intelligence
# Supabase:     postgresql+psycopg://postgres:<password>@db.<project>.supabase.co:5432/postgres
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/news_intelligence

# ─── Frontend ─────────────────────────────────────────────────────────────────
# Set this in frontend/.env.local for local dev
# VITE_API_BASE_URL=http://localhost:8000
# Production:
# VITE_API_BASE_URL=https://your-backend.onrender.com
